---
import 'dotenv/config';
import "bootstrap-icons/font/bootstrap-icons.min.css";

import '/src/styles/colors.css';
import '/src/styles/global.css';
import '/src/styles/entrylist.css';

const name = process.env.TITLE;
const baseURL = process.env.BASEURL || "/";
---
<head baseurl={baseURL}>
<title>Entries</title>
</head>
<div id="topicons">
<a href={baseURL} ><i class="bi bi-arrow-left"></i></a>

</div>
<hr>
<div id="dates">
</div>
<br><br><br>


<script>
document.addEventListener("DOMContentLoaded", async function() {
const baseURL = document.head.getAttribute("baseurl");

let hash = window.location.hash;
hash = hash.substring(1);
hash = decodeURI(hash);

if(/[^0-9]/g.test(hash)) {
return alert("invalid year");
}

// const response = await fetch('/entries.json');
const response = await fetch(baseURL+`api/entries?year=${hash}`);
const data = await response.json();

if(data.error) {
return alert(data.error);
}

const wrap = document.getElementById("dates");

  function createCalendar(elem, year, month) {

    let mon = month - 1; // months in JS are 0..11, not 1..12
    let d = new Date(year, mon);

    let table = `<h1>${d.toLocaleString('default', { month: 'long' })}</h1>`;


    // <td> with actual dates
    while (d.getMonth() == mon) {
    const cday = d.getDate();
    const cmonth = month;

    if (data.indexOf(`${cmonth}-${cday}`) !== -1) {
    table += '<div class="button valid">' + `<a href="${baseURL}entry#${cmonth}/${cday}/${hash}">` + cday + '</a></div>';
    } else {
    table += '<div class="button invalid">' + cday + '</div>';
    }



      d.setDate(d.getDate() + 1);
    }

    elem.innerHTML = table;
  }

  function getDay(date) { // get day number from 0 (monday) to 6 (sunday)
    let day = date.getDay();
    if (day == 0) day = 7; // make Sunday (0) the last day
    return day - 1;
  }

for (let i = 1; i < 13; i++) {
const poop = document.createElement("div");

createCalendar(poop, hash, i);

wrap.appendChild(poop);
}

// this is so far from my comfort zone thank you javascript.info
// https://javascript.info/task/calendar-table
});
</script>
<script src="/src/scripts/global.js"></script>
