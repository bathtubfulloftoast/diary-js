---
import 'dotenv/config';
import "bootstrap-icons/font/bootstrap-icons.min.css";

import '/src/styles/colors.css';
import '/src/styles/global.css';
import '/src/styles/entry.css';

import Favicon from '/src/components/favicon.astro';

const name = process.env.TITLE;
const pubURL = process.env.PUBLICURL;

const eURL = process.env.EDITORURL;
const ePATH = process.env.EDITORPATH;

const baseURL = process.env.BASEURL || "/";

let editurl = "";
if(eURL && ePATH) {
editurl = eURL + ePATH;
}
---
<head baseurl={baseURL} puburl={pubURL} editurl={editurl}>
<title>Entry</title>
<Favicon />
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body>
<div id="topicons"></div>
<hr>


<div id="content">

</div>
<hr>
<div id="bottomicons">
<a id="totop" href="#"><i class="bi bi-arrow-up"></i></a>
</div>

<br><br><br>
</body>

<script src="/src/scripts/entry.js"></script>
<script src="/src/scripts/entrybuttons.js"></script>
<script src="/src/scripts/global.js"></script>
