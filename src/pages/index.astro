---
import 'dotenv/config';

import '/src/styles/years.css';
import '/src/styles/colors.css';
import '/src/styles/global.css';

import Favicon from '/src/components/favicon.astro';

const name = process.env.TITLE;
const baseURL = process.env.BASEURL || "/";

---
<head baseurl={baseURL}> <!-- holy shit this is the official method they suggest -->
<title>{name}</title>
<Favicon />
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body>
<h1>{name}</h1>
<hr>
<div id="yearlist">
</div>

</body>

<script>
document.addEventListener("DOMContentLoaded", async function() {
const baseURL = document.head.getAttribute("baseurl");

// const response = await fetch(baseURL+'yearlist.json');
const response = await fetch(baseURL+'api/yearlist');
const data = await response.json();

const wrap = document.getElementById("yearlist");

data.forEach(myFunction);

function myFunction(item, index) {
const text = document.createElement("h2");
text.className="button";
const link = document.createElement("a");
link.innerHTML = item;
link.href= baseURL+"entries#"+item;

text.appendChild(link);
wrap.appendChild(text);
}
});
</script>
<script src="/src/scripts/global.js"></script>
