---
import 'dotenv/config';

import '/src/styles/years.css';
import '/src/styles/colors.css';
import '/src/styles/font.css';
import '/src/styles/global.css';

const name = process.env.TITLE;
---
<head>
<title>{name}</title>
</head>

<body>
<h1>{name}</h1>
<hr>
<div id="yearlist">
</div>

</body>
<script>
document.addEventListener("DOMContentLoaded", async function() {
// const response = await fetch('/yearlist.json');
const response = await fetch('/api/yearlist');
const data = await response.json();

const wrap = document.getElementById("yearlist");

data.forEach(myFunction);

function myFunction(item, index) {
const text = document.createElement("h2");
text.className="button";
const link = document.createElement("a");
link.innerHTML = item;
link.href= "/entries#"+item;

text.appendChild(link);
wrap.appendChild(text);
}
});
</script>
<script src="/src/scripts/global.js"></script>
