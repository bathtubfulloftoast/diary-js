---
import 'dotenv/config';

import '/src/styles/years.css';
import '/src/styles/colors.css';
import '/src/styles/global.css';

import Favicon from '/src/components/favicon.astro';

const name = process.env.TITLE;
const baseURL = process.env.BASEURL || "/";
const logo = process.env.LOGOIMG;

let header = name;
if (logo) {
header = `<img src="${baseURL}${logo}">`
}
// if anybody ever looks at this and knows a better solution please fucking tell me

---
<head baseurl={baseURL}> <!-- holy shit this is the official method they suggest -->
<title>{name}</title>
<Favicon />
<meta name="viewport" content="width=device-width, initial-scale=1">
</head>

<body>
<h1 id="title"><Fragment set:html={header} /></h1>
<hr>
<div id="yearlist">
</div>

</body>

<script src="/src/scripts/yearlist.js"></script>
<script src="/src/scripts/currententry.js"></script> <!-- im making this a seperate file so it can break safely and lazily. -->
<script src="/src/scripts/global.js"></script>
